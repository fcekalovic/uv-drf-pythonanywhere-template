# Copy this file to .env and fill in real values for local development.
# .env is git-ignored and must never contain committed secrets.

# Required. Django cryptographic secret key. Generate a unique value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-unique-random-value

# Optional. Enable debug mode (never enable in production). Defaults to False.
DEBUG=True

# Optional. Comma-separated list of allowed hosts. Defaults to empty.
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. Database connection URL. When unset, defaults to a local SQLite
# file (db.sqlite3). To use PostgreSQL instead, set e.g.:
#   DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_URL=sqlite:///db.sqlite3

# Optional. Shared secret that enables the self-service deploy endpoint
# (POST /deploy/). When unset or empty, the endpoint is DISABLED and returns
# HTTP 404. Set it to a long random value to enable unattended deploys, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production (PythonAnywhere), mirror this same value into your WSGI file's
# environment. Never commit a real token value.
# DEPLOY_TOKEN=change-me-to-a-long-random-value
